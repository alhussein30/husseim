rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can submit a lead; nobody can read/modify from the client.
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'projectType', 'message', 'createdAt', 'lang'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 7 && request.resource.data.phone.size() <= 20
        && request.resource.data.projectType in ['store', 'landing', 'brand', 'other']
        && request.resource.data.message is string && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
